#!/usr/bin/env bash

if [[ ${1:-} == --help ]]; then
    printf '%s\n' 'usage: nsh [-c LINE [NAME [ARG ...]]]' \
        'In a terminal, run Bash first and hand a nonzero result to yhwh.' \
        'Use @ to run prose explicitly and Readline to edit or recall a line.' \
        'Type :paste for multiple lines, ld.so COMMAND for plain Bash, or exit to leave.' \
        'Set NO_COLOR=1 to disable shell colors.'
    exit
fi
if (($#)) && [[ "$1" != -c || $# -lt 2 ]]; then
    printf 'usage: nsh [-c LINE]\n' >&2
    exit 2
fi

if (($#)) || [[ ! -t 0 || ! -t 2 ]]; then
    exec bash "$@"
fi

if [[ ${YHWH_LOGIN:-0} == 1 ]]; then
    [[ ! -r /etc/profile ]] || source /etc/profile
    [[ ! -r "$HOME/.profile" ]] || source "$HOME/.profile"
elif [[ -r /lib/ix/bashrc ]]; then
    source /lib/ix/bashrc
fi
NSH_HOME=$(realpath -m -- "${NSH_HOME:-$HOME/.nsh}") || exit
export NSH_HOME
(umask 077; mkdir -p -- "$NSH_HOME"/{etc,bin,lib}) || exit
PATH="$HOME/bin:$NSH_HOME/bin:$PATH"
export PATH

nsh_tmp=$(mktemp -d) || exit
trap 'rm -f -- "$nsh_tmp"/{stderr,context,reply,input}; rmdir -- "$nsh_tmp"' EXIT
shopt -s expand_aliases
nsh_history=()
nsh_status=0
nsh_question=
nsh_questions=0
nsh_failure=
nsh_failure_status=0
nsh_bash=
nsh_block=0
nsh_interrupted=0
nsh_terminal=0
nsh_question_style='1;33'
nsh_error_style='1;31'
trap 'nsh_interrupted=1' INT

nsh_load_bash() {
    local file="$NSH_HOME/etc/nsh.bash" contents=
    if [[ -r "$file" ]]; then
        contents=$(<"$file")
        if [[ "$contents" != "$nsh_bash" ]]; then
            bash -n "$file" && source "$file" || return
        fi
    fi
    nsh_bash=$contents
}

# The escape works in pipelines and keeps normal terminal descriptors.
ld.so() { "$@"; }

nsh_use_color() {
    ((nsh_terminal)) && [[ -t 2 && -n ${TERM:-} && $TERM != dumb && -z ${NO_COLOR:-} ]]
}

nsh_message() {
    local style=$1 message=$2
    if nsh_use_color; then
        printf '\033[%sm%s\033[0m\n' "$style" "$message" >&2
    else
        printf '%s\n' "$message" >&2
    fi
}

nsh_reply() {
    local backend_status reply
    {
        printf 'New Human Shell turn\nDirectory: %q\nNSH_HOME: %q\n' "$PWD" "$NSH_HOME"
        if [[ -n "$nsh_question" ]]; then
            printf 'The current input answers this question and Bash has not run it.\n'
            printf 'Pending question:\n%s\n' "${nsh_question:0:4096}"
        fi
        printf 'Failed Bash turn:\n%s\n' "$nsh_failure"
        if [[ -s "$NSH_HOME/etc/nshrc" ]]; then
            printf 'Saved scope definitions from etc/nshrc (last 32768 bytes):\n'
            tail -c 32768 -- "$NSH_HOME/etc/nshrc"
            printf '\n'
        fi
        printf 'Recent turns, oldest first:\n'
        printf '%s\n' "${nsh_history[@]}"
    } > "$nsh_tmp/context"
    yhwh turn "$nsh_line" < "$nsh_tmp/context" > "$nsh_tmp/reply"
    backend_status=$?
    if ((nsh_interrupted || backend_status == 130)); then
        nsh_question=
        return 130
    fi
    if ((backend_status)); then
        nsh_question=
        return "$nsh_failure_status"
    fi

    reply=$(<"$nsh_tmp/reply")
    case "$reply" in
        $'@ask\n'?*)
            if ((nsh_questions >= 20)); then
                nsh_question=
                nsh_message "$nsh_error_style" 'yhwh: twenty questions. Take it from the top.'
                return "$nsh_failure_status"
            fi
            ((nsh_questions++))
            nsh_question=${reply#*$'\n'}
            nsh_answer=$nsh_question
            nsh_message "$nsh_question_style" "$nsh_question"
            return 2
            ;;
        $'@fail\n'?*)
            nsh_question=
            nsh_answer=${reply#*$'\n'}
            nsh_message "$nsh_error_style" "$nsh_answer"
            return "$nsh_failure_status"
            ;;
    esac
    nsh_question=
    nsh_answer=$reply
    cat -- "$nsh_tmp/reply"
    nsh_load_bash || return
    hash -r
}

nsh_restore_status() { return "$1"; }

nsh_turn() {
    local nsh_directory=$PWD entry
    nsh_result='not run'
    nsh_answer=
    nsh_diagnostic=
    if [[ "$nsh_line" == :cancel ]]; then
        nsh_question=
        nsh_status=0
    elif [[ "$nsh_line" =~ ^[[:blank:]]*ld\.so([[:blank:]]|$) ]]; then
        nsh_restore_status "$nsh_status"
        eval -- "$nsh_line"
        nsh_status=$?
        nsh_result="exit $nsh_status"
    elif [[ -n "$nsh_question" ]]; then
        nsh_reply
        nsh_status=$?
    else
        nsh_restore_status "$nsh_status"
        eval -- "$nsh_line" 2> "$nsh_tmp/stderr"
        nsh_status=$?
        nsh_result="exit $nsh_status"
        if [[ -s "$nsh_tmp/stderr" ]]; then
            cat -- "$nsh_tmp/stderr" >&2
        fi
        if ((nsh_status && !nsh_interrupted)); then
            nsh_questions=0
            nsh_failure_status=$nsh_status
            printf -v nsh_failure 'Input: %s\nStarting directory: %q\nBash result: %s' \
                "$nsh_line" "$nsh_directory" "$nsh_result"
            if [[ -s "$nsh_tmp/stderr" ]]; then
                nsh_diagnostic=$(tail -c 4096 -- "$nsh_tmp/stderr")
                nsh_failure+=$'\nBash stderr (last 4096 bytes):\n'"$nsh_diagnostic"
            fi
            nsh_reply
            nsh_status=$?
        fi
    fi
    if ((nsh_interrupted)); then
        nsh_question=
        nsh_status=130
        nsh_interrupted=0
    fi
    if [[ -z "$nsh_question" ]]; then
        nsh_failure=
    fi
    [[ "$nsh_line" != ' '* ]] || return 0
    printf -v entry 'Input: %s\nBash: %s\nStatus: %s' "${nsh_line:0:4096}" "$nsh_result" "$nsh_status"
    if [[ -n "$nsh_diagnostic" ]]; then
        entry+=$'\n'"Stderr: ${nsh_diagnostic:0:1024}"
    fi
    if [[ -n "$nsh_answer" ]]; then
        entry+=$'\n'"Agent: ${nsh_answer:0:4096}"
    fi
    nsh_history+=( "$entry" )
    if ((${#nsh_history[@]} > 24)); then
        nsh_history=( "${nsh_history[@]: -24}" )
    fi
}

nsh_set_prompt() {
    local directory= marker=@ style='1;32'
    if ((nsh_block)); then
        marker='>'
        style='1;35'
        if [[ ${NSH_STYLE:-} == nhs ]]; then
            marker='...'
        fi
    elif [[ ${NSH_STYLE:-} == nhs ]]; then
        marker='>>>'
    else
        directory=$PWD
        case "$PWD" in
            "$HOME"|"$HOME/"*) directory="~${PWD#"$HOME"}" ;;
        esac
    fi

    if [[ -n "$nsh_question" ]]; then
        style=$nsh_question_style
    elif ((nsh_status && !nsh_block)); then
        style=$nsh_error_style
    fi

    if nsh_use_color; then
        # Readline uses these markers to exclude escape sequences from the prompt width.
        if [[ -n "$directory" ]]; then
            printf -v directory $'\001\e[36m\002%s\001\e[0m\002 ' "$directory"
        fi
        printf -v nsh_prompt $'%s\001\e[%sm\002%s\001\e[0m\002 ' "$directory" "$style" "$marker"
    else
        nsh_prompt="${directory:+$directory }$marker "
    fi
}

nsh_load_bash || exit
if [[ -t 0 ]]; then
    nsh_terminal=1
    nsh_readline=-e
    if ((BASH_VERSINFO[0] > 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] >= 3))); then
        nsh_readline=-E
    fi
    nsh_history_file="$NSH_HOME/history"
    if (umask 077; : >> "$nsh_history_file"); then
        shopt -s cmdhist lithist
        HISTTIMEFORMAT=${HISTTIMEFORMAT:-'%F %T '}
        history -r "$nsh_history_file"
    else
        nsh_history_file=
    fi
fi

while :; do
    nsh_input=
    if ((nsh_terminal)); then
        nsh_set_prompt
        nsh_tty=$(stty -g)
        # A trapped interrupt resumes Bash's read. Exit only the reader so
        # Ctrl+C discards its buffer and the parent keeps the shell state.
        (
            trap 'exit 130' INT
            IFS= read "$nsh_readline" -r -p "$nsh_prompt" nsh_input
            nsh_read=$?
            printf '%s' "$nsh_input" > "$nsh_tmp/input"
            exit "$nsh_read"
        )
        nsh_read=$?
        if ((nsh_read != 130 && ! nsh_interrupted)); then
            IFS= read -r -d '' nsh_input < "$nsh_tmp/input"
        else
            [[ -z "$nsh_tty" ]] || stty "$nsh_tty"
            printf '\n' >&2
        fi
    else
        IFS= read -r nsh_input
        nsh_read=$?
    fi
    if ((nsh_read == 130 || nsh_interrupted)); then
        nsh_question=
        nsh_failure=
        nsh_line=
        nsh_block=0
        nsh_interrupted=0
        nsh_status=130
        continue
    fi

    if ((nsh_block)); then
        if [[ -n "$nsh_input" ]]; then
            nsh_line+=${nsh_line:+$'\n'}"$nsh_input"
            ((nsh_read)) || continue
        fi
        nsh_block=0
    else
        nsh_line=$nsh_input
        if ((nsh_read == 0)) && [[ "$nsh_line" == :paste || ( "$nsh_line" == *: && -n "$nsh_question" ) ]]; then
            [[ "$nsh_line" != :paste ]] || nsh_line=
            nsh_block=1
            continue
        fi
    fi
    if [[ -n "$nsh_line" ]]; then
        if ((nsh_terminal)) && [[ "$nsh_line" != ' '* ]]; then
            history -s -- "$nsh_line"
            [[ -z "$nsh_history_file" ]] || history -a "$nsh_history_file"
        fi
        nsh_turn
    fi
    ((nsh_read == 0)) || break
done
exit "$nsh_status"
